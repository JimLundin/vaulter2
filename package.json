{
  "name": "vaulter",
  "version": "0.1.0",
  "description": "Speak a thought; a local Vaulter agent files it into your Markdown vault.",
  "type": "module",
  "bin": {
    "vaulter": "dist/cli.js"
  },
  "files": [
    "dist",
    "public"
  ],
  "scripts": {
    "build": "vite build && tsc",
    "build:web": "vite build",
    "build:runtime": "tsc",
    "dev": "concurrently -k -n web,runtime -c cyan,magenta \"npm:dev:web\" \"npm:dev:runtime\"",
    "dev:web": "vite",
    "dev:runtime": "VAULTER_NO_OPEN=1 VAULTER_DEV_URL=http://localhost:5173 VAULTER_VAULT=${VAULTER_VAULT:-.dev-vault} tsx watch src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "vite build && tsc"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.0",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.209",
    "ai": "^6.0.207",
    "ai-sdk-provider-claude-code": "^3.5.0",
    "streamdown": "^2.5.0"
  }
}
